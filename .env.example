NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバーサイドのみ（APIルートでの書き込みに使用）
SUPABASE_SERVICE_ROLE_KEY=

# OPS管理画面アクセス許可メール（カンマ区切り）
OPS_ADMIN_EMAILS=

# MVP+2: Stripe（テストモードのみ。sk_test_ / pk_test_ 以外は起動時にエラーにする）
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# MVP+2: 課金実行フラグ。既定false（未設定=false扱い）の間は全経路ドライラン
# （Stripeの課金APIを一切呼ばず、charge_eventsに記録のみ行う）
ENABLE_CHARGE_EXECUTION=false

# MVP+2: Vercel Cron（/api/cron/daily）の認可用シークレット。
# Vercelが自動付与する Authorization: Bearer $CRON_SECRET と照合する
CRON_SECRET=
